<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Nbu" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_primary</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <style name="ScanTheme" parent="Theme.Nbu">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="zxing_viewfinder_laser">@color/brand_primary</item>
    </style>

    <style name="LoginTitle">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowDx">4</item>
        <item name="android:shadowDy">4</item>
        <item name="android:shadowRadius">8</item>
    </style>

</resources>