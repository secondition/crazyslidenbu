<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 顶部 Header 背景 -->
        <View
            android:id="@+id/viewHeader"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@color/brand_primary"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.example.nbu.view.LampCord
            android:id="@+id/lampCord"
            android:layout_width="48dp"
            android:layout_height="140dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/toggle_theme"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            style="@style/LoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:text="@string/login_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Non terrae plus ultra."
            android:textSize="16sp"
            android:textStyle="italic"
            android:fontFamily="serif"
            android:textColor="@color/on_primary"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- 登录卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/surface"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvDisclaimer"
            app:layout_constraintVertical_bias="0.0">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/credentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <FrameLayout
                        android:id="@+id/usernameField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilUsername"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/student_id"
                            android:textColorHint="@color/text_secondary"
                            app:boxStrokeColor="@color/brand_primary"
                            app:hintTextColor="@color/brand_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUsername"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingStart="56dp"
                                android:paddingEnd="16dp"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionNext"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.example.nbu.view.InputSlider
                            android:id="@+id/usernameSlider"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="start|center_vertical"
                            android:padding="12dp"
                            android:src="@drawable/ic_user_alien"
                            android:contentDescription="@string/clear_student_id"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="@color/text_secondary"/>

                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/passwordField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/password"
                            android:textColorHint="@color/text_secondary"
                            app:boxStrokeColor="@color/brand_primary"
                            app:hintTextColor="@color/brand_primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:paddingStart="56dp"
                                android:paddingEnd="16dp"
                                android:textColor="@color/text_primary"
                                android:imeOptions="actionDone"/>

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.example.nbu.view.InputSlider
                            android:id="@+id/passwordSlider"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="start|center_vertical"
                            android:padding="12dp"
                            android:src="@drawable/ic_password_key"
                            android:contentDescription="@string/clear_password"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="@color/text_secondary"/>

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="32dp"
                        android:contentDescription="@string/log_in"
                        app:icon="@drawable/ic_accessibility"
                        app:iconPadding="0dp"
                        app:iconTint="@color/on_primary"
                        app:cornerRadius="8dp"
                        app:backgroundTint="@color/brand_primary"/>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/brand_primary"/>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:visibility="gone"/>

                </LinearLayout>

                <include
                    android:id="@+id/verification"
                    layout="@layout/view_verification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="32dp"/>

                <include
                    android:id="@+id/accounts"
                    layout="@layout/dialog_user_management"
                    android:visibility="gone"/>

                <include
                    android:id="@+id/editor"
                    layout="@layout/dialog_add_user"
                    android:visibility="gone"/>

                <include
                    android:id="@+id/share"
                    layout="@layout/dialog_account_code"
                    android:visibility="gone"/>

                <include
                    android:id="@+id/removal"
                    layout="@layout/view_remove_account"
                    android:visibility="gone"/>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvDisclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/disclaimer"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
